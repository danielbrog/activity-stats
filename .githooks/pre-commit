#!/bin/sh
# Runs the secret scan before every commit and cancels the commit unless it ends in CLEAN.
# Turn it on once per clone: git config core.hooksPath .githooks
#
# Scans against HEAD, so it checks only what's new since the last commit: staged and unstaged
# changes plus untracked files (a little more than the commit itself, which is the safe side).
# This works the same on main and on any branch.

# Hooks run from the repo root, so the script's relative paths work.
cd "$(git rev-parse --show-toplevel)" || exit 1

# A brand-new repo has no HEAD yet: compare against git's empty tree instead.
if git rev-parse --verify -q HEAD >/dev/null; then
    base=HEAD
else
    base=$(git hash-object -t tree /dev/null)
fi

# Git Bash on Windows has `python` or `py`; Linux and macOS usually have `python3`.
# `--version` weeds out the Windows Store stub, which exists but isn't a real Python.
for candidate in python "py -3" python3; do
    if $candidate --version >/dev/null 2>&1; then
        output=$($candidate -I scripts/scan_secrets.py "$base")
        status=$?
        echo "$output"
        if [ "$status" -eq 0 ] && [ "$(echo "$output" | tail -n 1)" = "CLEAN" ]; then
            exit 0
        fi
        echo "pre-commit: secret scan didn't end in CLEAN, so the commit was cancelled." >&2
        exit 1
    fi
done

echo "pre-commit: no Python found (tried python, py -3, python3), so the secret scan" \
    "couldn't run and the commit was cancelled." >&2
exit 1
