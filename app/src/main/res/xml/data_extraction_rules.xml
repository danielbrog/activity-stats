<?xml version="1.0" encoding="utf-8"?>
<!--
   What Android 12+ may back up or move to a new phone. The sign-in tokens are left out:
   they are encrypted with a key that never leaves this phone, so a copy would be unreadable,
   and a new phone should sign in fresh anyway.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/account.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
