<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for Android 11 and older (12+ uses data_extraction_rules.xml). The sign-in
   tokens are left out: they are encrypted with a key that never leaves this phone.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="file" path="datastore/account.preferences_pb" />
</full-backup-content>
